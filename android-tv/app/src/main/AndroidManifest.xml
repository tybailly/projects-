<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Android 11+ hides other installed apps from PackageManager queries
      (getLaunchIntentForPackage, etc.) unless explicitly declared here --
      without this, launching a subscribed provider's TV app directly
      silently fails (returns null) even when it's installed.
    -->
    <queries>
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
    </queries>

    <application
        android:name=".MyFlixApplication"
        android:allowBackup="true"
        android:banner="@drawable/ic_launcher"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyFlix"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MyFlix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
