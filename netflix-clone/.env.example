# Postgres
DATABASE_URL="postgresql://netflix:netflix@localhost:5432/netflix_clone"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="netflix-clone"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Public base URL used to build playback/poster URLs (MinIO console proxy or CDN in prod)
S3_PUBLIC_URL="http://localhost:9000/netflix-clone"
